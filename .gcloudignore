# Files not uploaded to Cloud Build by `gcloud run deploy --source`.
# Same syntax as .gitignore. Run `gcloud topic gcloudignore` for details.
.git
.gitignore
.github
.claude

node_modules/
**/node_modules/

# The client is deployed to GitHub Pages, not Cloud Run — it has no business
# in the server image and only slows the upload down.
client/

# Generated or local-only
client/dist/
coverage/
temp/
**/.env
**/.DS_Store

# A 31 MB macOS binary that is useless on Cloud Run's Linux containers.
cloud-sql-proxy

# Documentation
specs/
architecture.svg
README.md
env.yaml
